{
  "name": "obsidian-drag-out",
  "version": "0.1.2",
  "description": "Drag files from Obsidian's file explorer to other applications (local filesystem, browser uploads, email attachments, etc.) with native OS drag handles instead of obsidian:// URIs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
    "lint": "eslint main.ts manifest.json LICENSE --no-warn-ignored",
    "release": "bun release.mjs",
    "release:github": "bun release.mjs --github"
  },
  "keywords": ["obsidian", "plugin", "drag-and-drop"],
  "author": "Xander Berry",
  "authorUrl": "https://github.com/xwberry",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.33.1",
    "builtin-modules": "3.3.0",
    "electron": "^39.0.0",
    "esbuild": "0.24.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.2.4",
    "obsidian": "^1.4.11",
    "tslib": "2.7.0",
    "typescript": "5.5.4"
  }
}
